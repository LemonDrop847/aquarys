# AQUARYS Backend Configuration Environment Variables Example

DATABASE_URL=sqlite+aiosqlite:///aquarys.db
# For PostgreSQL with PostGIS & pgvector:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aquarys

OAH_BASE_URL=https://api.enora-oah.eu
OAH_API_KEY=your_oah_api_key_here
APP_MODE=demo
CORS_ORIGINS=http://localhost:3000

# LLM / Oracle Provider Configuration
LLM_PROVIDER=demo
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
